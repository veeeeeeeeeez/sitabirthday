# --- Cloudflare R2 (required) ---
# The subdomain of your bucket's S3 API endpoint:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com/<R2_BUCKET>
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2 -> Manage API Tokens -> Create API Token (Object Read & Write on your bucket)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=videos

# --- App config (optional) ---
# Whose birthday it is, shown all over the site
HONOREE_NAME=Sita

# Secret path for the viewing page, so a stray link doesn't spoil the surprise.
# The wall lives at /wall/<VIEW_KEY>. Leave blank to make /wall fully open.
VIEW_KEY=surprise

# Lets you delete a bad submission via the API. Make this long and random.
ADMIN_KEY=change_me_to_something_random

# Max upload size accepted from the browser, in megabytes
MAX_UPLOAD_MB=200

# Render sets this automatically; only needed for local dev
PORT=3000
